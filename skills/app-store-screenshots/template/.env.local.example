# Server-side only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to the balanced design model below.
OPENAI_DESIGN_MODEL=gpt-5.6-terra

# Optional. Generates requested visual backdrops; defaults to GPT Image 2.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional. Set DESIGN_PROVIDER=anthropic to design with Claude. Drafts default
# to claude-opus-5-5 and chat edits to claude-sonnet-5-5; artwork stays on
# OpenAI. Server-side only, like the OpenAI key.
# DESIGN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
