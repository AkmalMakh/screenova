# Local development keeps the existing JSON workspace and local images.
# For a hosted beta, change this to supabase and fill both public values below.
# Never deploy local mode to the public internet.
APP_STORAGE_MODE=local

# Supabase Project Settings > API / Connect. These are public browser settings.
# Do NOT put a secret key or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Optional for manual editing and export.
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Local mode only; optional absolute path to the existing workspace JSON.
# APP_STORE_PROJECT_FILE=/absolute/path/projects.json
